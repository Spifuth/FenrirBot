# =============================================================
# FenrirBot — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# === Required ===
DISCORD_TOKEN=your_discord_bot_token_here
ANNOUNCEMENT_CHANNEL_ID=123456789012345678

# === Optional ===
NOTIFICATION_ROLE_ID=0
COMMAND_PREFIX=!
REPORTS_CHANNEL_ID=0

# === Uptime Kuma ===
# Public API (for status queries)
UPTIMEKUMA_URL=http://localhost:3001
UPTIMEKUMA_API_KEY=
UPTIMEKUMA_STATUS_PAGE=default
# Authenticated API (for pause/resume monitors during maintenance)
UPTIMEKUMA_USERNAME=
UPTIMEKUMA_PASSWORD=
UPTIMEKUMA_AUTO_PAUSE=true

# === Webhook Server ===
# Enable to receive alerts from Grafana, Netdata, Prometheus, UptimeKuma
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8085
WEBHOOK_SECRET=

# === Netdata ===
NETDATA_URL=http://localhost:19999
NETDATA_API_KEY=